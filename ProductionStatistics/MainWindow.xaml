<ui:ChromeBorderlessWindow x:Class="ProductionStatistics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="生产履历 - 点胶固化收料机"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="920" Width="1240" MinHeight="780" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        CaptionHeight="0" CornerRadius="18"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="窗口_StateChanged"
        SizeChanged="窗口_SizeChanged"
        TextOptions.TextFormattingMode="Ideal">

    <!-- ================= 界面布局（ASCII 图，改界面必须同步更新本图） =================
        说明：窗口为**自绘窗口**——去掉系统标题栏（WindowStyle=None + AllowsTransparency=True），
              整个外框做成圆角（外层阴影 Border + 内容层圆角 Border），右上角三个窗口按钮
              （最小化 / 最大化还原 / 关闭）画在顶栏最右、"设置" 按钮的右侧；
              【V2.3.1】留白内的顶栏 / 页签带 / 状态条三块白底也带圆角（详见下方外框结构说明）。
        ┌──────────────────────────────────────────────────────────────────────────────┐
        │ 顶栏 Auto：Logo+标题 │ PLC状态胶囊 时钟 主题开关 中文/English 设置▾ ─ □ ✕    │
        │ 页签栏 Auto：7 个页签 = 6 班次页签（两行文字：班次名+日期）+ "历史查询"工具  │
        │ KPI 区 Auto：6 张 KPI 卡片（**一行 6 列**，渐变主色竖条 + 大数字 + 副说明）   │
        │             （选中"历史查询"页签时：KPI 区与主表格隐藏，换成查询面板）      │
        ├───────────────────────────────────────────┬───────────────────────────────┤
        │ 主表格 *：DataGrid 12 小时行 + 合计行      │ 右侧栏 320px                 │
        │  列：时段/小时产能/OK/NG/良率/生产/待料/   │  · 设备状态卡（自动中/报警/   │
        │      报警/停止/稼动率                      │    稼动率圆环）               │
        │                                            │  · 单元卡（三单元 OK/NG/IDLE）│
        │            （右侧栏提示卡已删除【V2.4.0】：报警/离线状态在底栏状态条已有， │
        │              两处重复信息没有意义）                                        │
        ├───────────────────────────────────────────┴───────────────────────────────┤
        │ 状态条 Auto：设备状态灯 + 大字 + 右侧采样/落盘/日志信息                       │
        └──────────────────────────────────────────────────────────────────────────────┘
    ================================================================================ -->

    <!--
        窗口外观说明：
          · 窗口 Background=Transparent + AllowsTransparency=True，四个角由下面这层圆角 Border 裁出来；
          · **不用 DropShadowEffect 做外阴影**：它的模糊扩散会画到窗口的透明区域上，
            在四个角上留下暗色方块（用户反馈"外框四角圆角没处理好"的根因）。
            层次改用"描边 + 卡片自身阴影"体现，四个角保持干净。
    -->
    <!--
        外框结构（重要，改界面先看这里）：
          · 窗口继承 kaleidoscope 的 ChromeBorderlessWindow（V2.2.0）：分层真圆角三件套 /
            WindowChrome 外壳 / 根 Border 圆角 Clip / 最大化工作区修正全部由基类负责——
            本文件**不要**再写 WindowStyle=None、AllowsTransparency、Background、WindowChrome。
          · 根内容必须是 Border（基类约定 Window.Content as Border）：就是下面的
            「窗口内容」Border——视觉圆角与溢出裁剪的载体；CornerRadius 写值必须与
            窗口的 CornerRadius="18" 一致（基类最大化归零、还原取 DP 值）。
          · CaptionHeight=0：本工程顶栏是业务内容、按钮多，拖动仍由
            MouseLeftButtonDown 手动处理（双击=最大化/还原），不让 WindowChrome
            把顶栏吞成系统标题区——否则设置按钮/主题开关/语言按钮点不到。
          · 四角 12px 圆角留白放在根 Border 的 Padding 里；最大化时由代码把
            Padding/BorderThickness 置 0（圆角由基类同步归零），铺满工作区。
          · 【V2.3.1】留白内的三块白底内容（顶栏 / 页签带 / 状态条）自带圆角，消除
            "外壳圆、内容直角"的错位：顶栏圆上缘两角（Fn.ShellRadiusTop）、页签带圆下缘
            两角（Fn.ShellRadiusBottom）、状态条四角全圆（Fn.ShellRadius）；最大化归零 /
            还原挂回令牌统一在 窗口_StateChanged。
    -->
    <Border x:Name="窗口内容" CornerRadius="18" BorderThickness="1" Padding="12"
            BorderBrush="{DynamicResource Line2Brush}" Background="{DynamicResource BgBrush}">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 主体行：必须给 MinHeight 兜底！否则窗口被拖小时，
                 DataGrid 的内容高度会通过 Grid 反过来把窗口撑大 / 溢出，
                 表现为"缩小后内容显示不完整"（表格自己内部滚动即可） -->
            <RowDefinition Height="*" MinHeight="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <!-- 顶栏容器用库 KxTopBar（面板底 + 下边线 + Padding 20,14）；顶栏仍是业务内容，
             拖动/双击由 MouseLeftButtonDown 手动处理（窗口 CaptionHeight=0）。
             CornerRadius【V2.3.1】顶栏白底只圆上缘两角（库令牌 Fn.ShellRadiusTop），
             与外壳圆角呼应；最大化归零/还原挂回令牌见 窗口_StateChanged。 -->
        <Border x:Name="顶栏区" Grid.Row="0" Style="{StaticResource KxTopBar}"
                CornerRadius="{DynamicResource Fn.ShellRadiusTop}"
                MouseLeftButtonDown="标题栏_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左：Logo + 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo：改用真实应用图标（Resources\app.png，圆形徽标），与 exe / 任务栏图标同一套 -->
                    <Border Width="40" Height="40" CornerRadius="20"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1">
                        <Image Source="pack://application:,,,/Resources/app.png" Width="34" Height="34"
                               Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                               ToolTip="生产统计" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="标题文字" Text="生产履历" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="副标题文字" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                   Text="Machine Name: 点胶固化收料机" />
                    </StackPanel>
                </StackPanel>

                <!-- 右：状态 + 时钟 + 主题 + 语言 + 设置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- PLC 连接状态胶囊（库 StatusChip：Tag=Ok/Ng 切语义弱底+文字色，
                         代码只改 Tag 不改颜色，切主题零遗漏）。
                         Padding 上下不对称【V2.4.0】：雅黑字体行盒里 CJK 字形墨迹天然偏上
                         （像素实测 墨迹上 12px / 下 19px，需整体下移约 2 DIP），上 8 下 4
                         让内容盒整体下移，胶囊总高不变、文字视觉上下居中
                         （圆点 KxStatusDot 自带 VerticalAlignment=Center 不受影响）。 -->
                    <Border x:Name="连接胶囊" Style="{StaticResource StatusChip}" Tag="Ok"
                            Padding="12,8,12,4" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="连接指示灯" Style="{StaticResource KxStatusDot}" Tag="Ok"
                                     Margin="0,0,8,0" />
                            <TextBlock x:Name="连接状态文字" Style="{StaticResource StatusChipText}" Tag="Ok"
                                       Text="PLC 已连接" FontSize="12.5" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="时钟文字" Text="2026-01-01 00:00:00" FontFamily="Consolas, Microsoft YaHei UI"
                               Foreground="{DynamicResource Text2Brush}" FontSize="13.5" VerticalAlignment="Center"
                               Margin="0,0,16,0" />

                    <!-- 主题开关（深/浅）：勾选 = 深色 → 库 KxThemeSwitch（3D 轨道 + 月/日滑块） -->
                    <ToggleButton x:Name="主题开关" Style="{StaticResource KxThemeSwitch}" IsChecked="False"
                                  Click="主题开关_Click" Margin="0,0,14,0" ToolTip="深色 / 浅色主题" />

                    <!-- 语言 -->
                    <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="2" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="语言中文" Style="{StaticResource KxLangButton}" Content="中文"
                                         IsChecked="True" Checked="语言按钮_Click" Tag="中文" />
                            <RadioButton x:Name="语言英文" Style="{StaticResource KxLangButton}" Content="English"
                                         Checked="语言按钮_Click" Tag="English" />
                        </StackPanel>
                    </Border>

                    <!-- 登录按钮【V2.4.1】：原"启动强制登录"改为顶栏按需登录——
                         软件启动直接进看板，不登录也能查看/导出；点本按钮弹 LoginWindow
                         （模态，Owner=主窗居中），登录成功后按钮显示当前用户名，再点可切换账号。
                         样式用库 KxSecondaryButton（ghost 描边），不与"设置"主色按钮抢视觉。 -->
                    <Button x:Name="登录按钮" Style="{StaticResource KxSecondaryButton}" Click="登录按钮_Click"
                            Content="登录" Padding="16,8" FontSize="13" Margin="0,0,10,0"
                            ToolTip="登录 / 切换账号" />

                    <!-- 设置按钮【V2.4.0】：原"导出 Excel"按钮改为"设置"下拉入口
                         （导出 Excel 收拢进历史查询面板）。点击后弹下拉菜单（WinContextMenu +
                         WinMenuItem 库样式，项=占位，后续在此挂实际设置功能）。
                         PlacementTarget 必须在代码里显式指回本按钮（库菜单四要点①：
                         不锚定宿主会弹到屏幕 (0,0)），见 设置按钮_Click。 -->
                    <Button x:Name="设置按钮" Style="{StaticResource KxPrimaryButton}" Click="设置按钮_Click"
                            Content="设置" Padding="16,8" FontSize="13">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="设置菜单" Style="{StaticResource WinContextMenu}">
                                <MenuItem x:Name="设置项一" Style="{StaticResource WinMenuItem}" Header="功能 1（占位）"
                                          Click="设置项_Click" />
                                <MenuItem x:Name="设置项二" Style="{StaticResource WinMenuItem}" Header="功能 2（占位）"
                                          Click="设置项_Click" />
                                <MenuItem x:Name="设置项三" Style="{StaticResource WinMenuItem}" Header="功能 3（占位）"
                                          Click="设置项_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- 窗口按钮（最小化 / 最大化还原 / 关闭）：库 KxTitle*Button 族，
                         宽度 40/高 28 由库口径，宿主只覆盖宽高贴齐原视觉（34×28）。
                         【V2.4.0】三个图标 Path 都补 Width/Height=14 设计画布：Path 缺省
                         Stretch=None 时几何按原始坐标渲染、元素却只按几何 bounds 尺寸参与
                         居中（minimize 线 bounds 高=0），实测图标整体偏下（min 偏 6.8px）——
                         显式给满 14×14 画布后 ContentPresenter 居中的就是整个画布，图标
                         回到正中（min 线 y 从 7.5 修到 7 与画布中心 7 对齐）。 -->
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button x:Name="最小化按钮" Style="{StaticResource KxTitleMinButton}" Click="最小化按钮_Click"
                                ToolTip="最小化" Width="34" Height="28">
                            <Path Data="M3,7 H11" Width="14" Height="14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="最大化按钮" Style="{StaticResource KxTitleMaxButton}" Click="最大化按钮_Click"
                                ToolTip="最大化" Width="34" Height="28">
                            <Path x:Name="最大化图标" Data="M3.5,3.5 H10.5 V10.5 H3.5 Z" Width="14" Height="14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                        </Button>
                        <Button x:Name="关闭按钮" Style="{StaticResource KxTitleCloseButton}" Click="关闭按钮_Click"
                                ToolTip="关闭" Width="34" Height="28">
                            <Path Data="M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5" Width="14" Height="14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 页签栏 ==================== -->
        <!-- CornerRadius【V2.3.1】页签白带只圆下缘两角（库令牌 Fn.ShellRadiusBottom，
             本轮新沉淀进库），消除内容块与外壳圆角相接处的直角；最大化归零见 窗口_StateChanged。 -->
        <Border x:Name="页签区" Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,12"
                CornerRadius="{DynamicResource Fn.ShellRadiusBottom}">
            <ItemsControl x:Name="页签控件" ItemsSource="{Binding 页签列表}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 用 UniformGrid 而不是 WrapPanel：WrapPanel 在窄窗口会换行，
                             页签区高度一变，整窗内容高度跟着变，窗口就会被撑破屏幕；
                             7 列 = 6 个班次页签 + 1 个"历史查询"工具页签【V2.3.1】 -->
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 双行页签用库 KxShiftTab（选中=主色弱底+主色描边+加粗） -->
                        <ToggleButton Style="{StaticResource KxShiftTab}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Click="页签按钮_Click"
                                      Tag="{Binding 序号}">
                            <StackPanel>
                                <TextBlock Text="{Binding 名称}" FontSize="13" />
                                <TextBlock Text="{Binding 日期}" FontSize="10.5" Foreground="{DynamicResource Text3Brush}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ==================== KPI 卡片区 ==================== -->
        <ItemsControl x:Name="KPI区" Grid.Row="2" ItemsSource="{Binding KPI列表}" Margin="20,12,20,4">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- KPI 一行 6 张（用户要求：红框区域一行显示，不分两行） -->
                    <UniformGrid Columns="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 左侧主色竖条 -->
                            <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,2,12,2"
                                    Background="{DynamicResource AccentGradientBrush}" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource KxIconBox}" Margin="0,0,8,0">
                                        <Path Data="{Binding 图标路径}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                              Fill="Transparent" Stretch="Uniform" Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding 标题}" Style="{StaticResource CardTitleText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding 数值}" Style="{StaticResource KpiValueText}" />
                                    <TextBlock Text="{Binding 单位}" Style="{StaticResource KpiUnitText}" />
                                </StackPanel>
                                <TextBlock Text="{Binding 副说明}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ==================== 主体：表格 + 右侧栏 ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- 右侧栏宽度随窗口宽度自动调整（代码里 280 / 300 / 320 三档） -->
                <ColumnDefinition x:Name="右侧栏列" Width="280" />
            </Grid.ColumnDefinitions>

            <!-- 主表格 -->
            <!-- 表格卡片：不画右边框（表格最后一列的竖线就是右边界，避免两条线紧挨着）；
                 CornerRadius【V2.3.1】改走库令牌 Fn.ShellCardRadius（值同 18，去硬编码） -->
            <Border x:Name="表格卡片" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0" Margin="20,12,12,16" CornerRadius="{DynamicResource Fn.ShellCardRadius}" Padding="0">
                <!-- ui:KxRoundedClip.Radius【V2.3.1】库新沉淀的圆角裁剪附加属性：DataGrid 表头/行底
                     自带方角背景会盖住卡片圆弧（Border.CornerRadius 不裁子元素），挂 12px 裁剪
                     （=卡片 18 − 网格内边距 6，同心圆弧）让表格四角跟随卡片圆角 -->
                <DataGrid x:Name="表格" ItemsSource="{Binding 表格行}" Margin="6,6,6,6"
                          ui:KxRoundedClip.Radius="12">
                    <DataGrid.Columns>
                        <!-- 时段列固定宽度，其余 9 列用 * 均分剩余空间：窗口再窄也一屏显示完，不出横向滚动条 -->
                        <DataGridTextColumn Header="时段" Binding="{Binding Period}" Width="92" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="小时产能(PCS)" Binding="{Binding Total}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="OK产能(PCS)" Binding="{Binding Ok}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="NG产能(PCS)" Binding="{Binding Ng}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="良率%" Binding="{Binding Yield}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="生产时间(Min)" Binding="{Binding Production}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="待料时间(Min)" Binding="{Binding Wait}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="报警时间(Min)" Binding="{Binding Alarm}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="停止时间(Min)" Binding="{Binding Stop}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        <DataGridTextColumn Header="稼动率%" Binding="{Binding Utilization}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ==================== 历史查询面板【V2.3.1】 ==================== -->
            <!-- 选中第 7 个页签（历史查询）时显示：按日期区间 + 单元筛选从 SQLite 库取数，
                 可导出 Excel / CSV【V2.4.0】导出 Excel 从顶栏收拢到本面板（顶栏原按钮改为"设置"下拉），
                 导出口径=当前查询结果（同屏所见即所得）。
                 控件全复用库样式（KxCard / KxDatePicker / KxComboBox / KxPrimaryButton / KxSecondaryButton）零自绘；
                 显示切换在 切换历史视图，查询/导出在 查询按钮_Click / 查询导出Excel按钮_Click / 查询导出按钮_Click，
                 列头随语言在 应用语言()。 -->
            <Border x:Name="查询面板" Grid.Column="0" Style="{StaticResource KxCard}" Margin="20,12,12,16"
                    Padding="14" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="查询从标签" Text="从" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker x:Name="查询起始" Style="{StaticResource KxDatePicker}" Width="130" Margin="0,0,12,0" />
                        <TextBlock x:Name="查询至标签" Text="至" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker x:Name="查询截止" Style="{StaticResource KxDatePicker}" Width="130" Margin="0,0,12,0" />
                        <TextBlock x:Name="查询单元标签" Text="单元" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="查询单元" Style="{StaticResource KxComboBox}" Width="110" Margin="0,0,16,0" SelectedIndex="0" />
                        <Button x:Name="查询按钮" Style="{StaticResource KxPrimaryButton}" Content="查询"
                                Click="查询按钮_Click" Padding="16,7" Margin="0,0,10,0" />
                        <!-- 导出 Excel【V2.4.0】：收拢进历史查询的 xlsx 导出（原顶栏按钮职责迁移到这里） -->
                        <Button x:Name="查询导出Excel按钮" Style="{StaticResource KxSecondaryButton}" Content="导出 Excel"
                                Click="查询导出Excel按钮_Click" Padding="14,7" Margin="0,0,10,0" />
                        <Button x:Name="查询导出按钮" Style="{StaticResource KxSecondaryButton}" Content="导出 CSV"
                                Click="查询导出按钮_Click" Padding="14,7" />
                        <TextBlock x:Name="查询结果数" Style="{StaticResource CaptionText}" Text="0 行"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <!-- 同主表格：KxRoundedClip 让查询结果表四角跟随卡片圆角【V2.3.1】 -->
                    <DataGrid x:Name="查询表格" Grid.Row="1" Margin="6,10,6,6" ItemsSource="{Binding 查询行}"
                              ui:KxRoundedClip.Radius="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="查询列日期" Header="日期" Binding="{Binding 日期}" Width="90" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列班次" Header="班次" Binding="{Binding 班次}" Width="62" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列时段" Header="时段" Binding="{Binding 时段}" Width="92" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列产能" Header="小时产能(PCS)" Binding="{Binding Total}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列OK" Header="OK产能(PCS)" Binding="{Binding Ok}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列NG" Header="NG产能(PCS)" Binding="{Binding Ng}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列良率" Header="良率%" Binding="{Binding Yield}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列生产" Header="生产时间(Min)" Binding="{Binding Production}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列待料" Header="待料时间(Min)" Binding="{Binding Wait}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列报警" Header="报警时间(Min)" Binding="{Binding Alarm}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列停止" Header="停止时间(Min)" Binding="{Binding Stop}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                            <DataGridTextColumn x:Name="查询列稼动率" Header="稼动率%" Binding="{Binding Utilization}" Width="*" ElementStyle="{StaticResource TableCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右侧栏（外面套 ScrollViewer：窗口被缩小时内容可滚动，不会被裁掉，
                 同时右栏两张卡片的高度不再撑大整个窗口） -->
            <ScrollViewer x:Name="右栏滚动" Grid.Column="1" Margin="0,12,20,16"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- 设备状态 -->
                <Border Style="{StaticResource KxCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="设备状态标题" Text="设备状态" Style="{StaticResource SectionTitle}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="设备状态徽标" Text="运行中" HorizontalAlignment="Right"
                                       Style="{StaticResource StatusChipText}" Tag="Ok" FontSize="12.5" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="自动中标题" Text="设备自动中" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                <TextBlock Text="M3200" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="自动中文字" Grid.Column="1" Text="停止" FontSize="13"
                                       Style="{StaticResource StatusChipText}" FontWeight="Normal" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="报警标题" Text="设备报警" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                <TextBlock Text="M3201" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="报警文字" Grid.Column="1" Text="正常" FontSize="13"
                                       Style="{StaticResource StatusChipText}" FontWeight="Normal" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="稼动率标题" Text="本班稼动率" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                                <!-- 说明文字：一行显示完、左侧与"本班稼动率"对齐（不能设 MaxWidth，
                                 设了 Stretch 会退化成居中，文字就比标题缩进了一截） -->
                            <TextBlock x:Name="稼动率说明" Text="生产 ÷（生产+待料+报警+停止）" Style="{StaticResource CaptionText}"
                                       FontSize="10" Margin="0,3,0,0" TextWrapping="NoWrap" />
                            </StackPanel>
                            <!-- 稼动率圆环（库 KxRingBg/KxRingValue + 代码设 StrokeDashArray 画弧） -->
                            <Grid Grid.Column="1" Width="46" Height="46" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource KxRingBg}" />
                                <Ellipse x:Name="稼动率弧" Style="{StaticResource KxRingValue}"
                                         StrokeDashArray="0 145" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="稼动率文字" Text="0.0" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI"
                                           FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 三单元状态 -->
                <Border Style="{StaticResource KxCard}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="单元栏标题" Text="单元状态 / 本班统计" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding 单元列表}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,7">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding 名称}" Foreground="{DynamicResource TextBrush}"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="{Binding 地址}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" />
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Style="{StaticResource StatusChip}" Tag="Ok" Padding="8,2" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding OK文字}" Style="{StaticResource StatusChipText}" Tag="Ok"
                                                           FontSize="11" />
                                            </Border>
                                            <Border Style="{StaticResource StatusChip}" Tag="Ng" Padding="8,2" Margin="0,0,7,0">
                                                <TextBlock Text="{Binding NG文字}" Style="{StaticResource StatusChipText}" Tag="Ng"
                                                           FontSize="11" />
                                            </Border>
                                            <!-- 无 Tag：中性灰（FgDim + HoverBg），对应"空闲/运行"实时态 -->
                                            <Border Style="{StaticResource StatusChip}" Padding="8,2">
                                                <TextBlock Text="{Binding 状态文字}" Style="{StaticResource StatusChipText}"
                                                           FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 【V2.4.0】原第三张"提示"卡已删除：报警 / 离线提示与底部状态条完全重复
                     （状态条同样实时显示 PLC 连接失败 / 设备报警中），两处信息冗余没有意义。
                     右侧栏现在只剩 设备状态 + 单元状态 两张卡。 -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部状态条 ==================== -->
        <!-- CornerRadius【V2.3.1】状态条四角全圆（库令牌 Fn.ShellRadius=10）：它与表格卡片之间
             本就有 16px 空隙、四周贴着 12px 留白，是个悬浮块，四角全圆与 KPI 卡片观感一致；
             最大化归零/还原挂回令牌见 窗口_StateChanged。 -->
        <Border x:Name="状态条区" Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="20,10"
                CornerRadius="{DynamicResource Fn.ShellRadius}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="状态灯" Style="{StaticResource KxStatusDot}" Tag="Warn"
                             Width="11" Height="11" Margin="0,0,11,0" />
                    <TextBlock x:Name="状态条文字" Style="{StaticResource StatusChipText}" Tag="Warn"
                               Text="设备暂停中!" FontSize="13.5" />
                </StackPanel>
                <TextBlock x:Name="底栏信息" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="采样 100ms · 最近落盘 -- · 日志 logs\运行日志_日期.log" />
            </Grid>
        </Border>
        </Grid>
    </Border>
</ui:ChromeBorderlessWindow>
