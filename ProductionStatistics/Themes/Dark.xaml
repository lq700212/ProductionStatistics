<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        深色主题（B 现代卡片风格 · 深色变体）
        键名与 Light.xaml 完全一致：界面里所有颜色都用 DynamicResource 引用，
        切换主题时只换这一本字典，控件样式（Controls\Styles.xaml）自动跟随。
        深色是工控夜班的刚需：现场夜班值守时屏幕偏暗，深色主题可降低眩光。
    -->
    <Color x:Key="BgColor">#080B13</Color>
    <Color x:Key="Bg2Color">#0D1220</Color>
    <Color x:Key="PanelColor">#111827</Color>
    <Color x:Key="Panel2Color">#0F1626</Color>
    <Color x:Key="Panel3Color">#151D30</Color>
    <Color x:Key="TextColor">#E6EDF7</Color>
    <Color x:Key="Text2Color">#8FA0BB</Color>
    <Color x:Key="Text3Color">#61708C</Color>
    <Color x:Key="LineColor">#1E2A42</Color>
    <Color x:Key="Line2Color">#2A3752</Color>
    <Color x:Key="HeadColor">#16203A</Color>
    <Color x:Key="HeadTextColor">#9FB3D1</Color>
    <Color x:Key="OkColor">#3DDC97</Color>
    <Color x:Key="NgColor">#FF6B6B</Color>
    <Color x:Key="WarnColor">#FFC857</Color>
    <Color x:Key="IdleColor">#FFA94D</Color>
    <!-- 深色下主色提亮，保证在暗底上有足够对比度 -->
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="Accent2Color">#22D3EE</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}" />
    <SolidColorBrush x:Key="Panel3Brush" Color="{StaticResource Panel3Color}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}" />
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" />
    <SolidColorBrush x:Key="HeadBrush" Color="{StaticResource HeadColor}" />
    <SolidColorBrush x:Key="HeadTextBrush" Color="{StaticResource HeadTextColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="NgBrush" Color="{StaticResource NgColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="IdleBrush" Color="{StaticResource IdleColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />

    <!-- 主色浅底（选中 / 悬停 / 高亮块）：深色主题用 16% 不透明度 -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="OkSoftBrush" Color="{StaticResource OkColor}" Opacity="0.16" />
    <SolidColorBrush x:Key="NgSoftBrush" Color="{StaticResource NgColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnColor}" Opacity="0.18" />
    <SolidColorBrush x:Key="IdleSoftBrush" Color="{StaticResource IdleColor}" Opacity="0.18" />
    <!-- 卡片阴影（深色用纯黑，投影更明显） -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.45" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
