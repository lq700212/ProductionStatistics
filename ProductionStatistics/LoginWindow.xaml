<ui:ChromeDialogWindow x:Class="ProductionStatistics.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Kaleidoscope.UI.Views;assembly=Kaleidoscope.UI"
        Title="用户登录"
        Width="420" Height="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">
        <!-- 注意【V2.4.0】：不要设 ShowInTaskbar=False——.NET Process.MainWindowHandle
             会跳过不在任务栏的窗口返回 0，E2E/截图 harness 全靠 MainWindowHandle 找
             登录窗自动登录（实测踩坑）。登录窗在任务栏短暂出现是可接受代价。 -->

    <!-- ================= 登录窗【V2.4.0】 =================
        做什么：软件启动的第一道门——App.OnStartup 先弹本窗（模态），验证通过才创建主窗。
        骨架说明：继承库 ChromeDialogWindow（圆角自绘弹窗基类），标题条/圆角/投影/拖动
            全由基类负责，本文件只写内容槽里的登录表单（右上角自带 × 关闭=取消登录退出程序）。
        样式契约：输入框用库 KxTextBox / KxPasswordBox，主按钮用 KxPrimaryButton（与主窗
            同一套控件族），错误提示用 StatusChipText 语义色（Tag=Ng 红）——切主题全跟随。
        交互：用户名/密码框回车=登录；输错显示红字提示并清空密码框；账号预置 admin/123456
            （见 Business\LoginService.cs，界面不显示账号提示，避免把凭据贴在屏幕上）。
    -->

    <StackPanel Margin="34,26,34,18">

        <!-- 顶部：Logo + 软件名 + 设备名（与主窗顶栏同一视觉语言） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
            <Border Width="44" Height="44" CornerRadius="22"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource Line2Brush}" BorderThickness="1">
                <Image Source="pack://application:,,,/Resources/app.png" Width="38" Height="38"
                       Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="登录标题" Text="生产统计" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="登录副标题" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                           Text="Machine Name: 点胶固化收料机" />
            </StackPanel>
        </StackPanel>

        <!-- 用户名 -->
        <TextBlock x:Name="用户名标签" Text="用户名" Margin="0,20,0,6" Foreground="{DynamicResource Text2Brush}" />
        <TextBox x:Name="用户名输入" Style="{StaticResource KxTextBox}" Height="34" FontSize="13"
                 KeyDown="输入框_KeyDown" />

        <!-- 密码 -->
        <TextBlock x:Name="密码标签" Text="密码" Margin="0,14,0,6" Foreground="{DynamicResource Text2Brush}" />
        <PasswordBox x:Name="密码输入" Style="{StaticResource KxPasswordBox}" Height="34" FontSize="13"
                     KeyDown="输入框_KeyDown" />

        <!-- 错误提示（默认隐藏，验证失败才显示；StatusChipText Tag=Ng → 红字） -->
        <TextBlock x:Name="错误提示" Style="{StaticResource StatusChipText}" Tag="Ng" FontSize="12"
                   FontWeight="Normal" Margin="0,10,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed" Text="用户名或密码错误" />

        <!-- 登录按钮：库 KxPrimaryButton 主渐变胶囊 -->
        <Button x:Name="登录按钮" Style="{StaticResource KxPrimaryButton}" Content="登 录"
                Click="登录按钮_Click" Height="38" FontSize="14" Margin="0,18,0,0" Cursor="Hand" />

        <!-- 底部版本信息 -->
        <TextBlock x:Name="版本文字" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                   Margin="0,16,0,0" Text="生产统计 V" />
    </StackPanel>
</ui:ChromeDialogWindow>
