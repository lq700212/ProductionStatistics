<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        B「现代卡片」风格的全套控件样式。
        颜色一律用 DynamicResource 引用主题字典（Themes\Light.xaml / Dark.xaml），
        所以切换主题时这一本样式不用动，界面自动跟着变。
        视觉语言借鉴 D:\杂项\galaxy（Uiverse.io，MIT 许可）：
          · 开关        ← Toggle-switches/Admin12121/massive-dodo-67（3D 轨道 + 滑块）
          · 主按钮      ← Buttons/0x3ther/heavy-dragon-56（图标 + rounded-md + 悬停变色）
          · 卡片/徽标   ← Cards/MijailVillegas/smooth-firefox-47（浅底 + 主色高亮）
          · 加载环      ← loaders/StealthWorm/cuddly-wasp-46（霓虹描边圆环）
    -->

    <!-- ===================== 尺寸规范 ===================== -->
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="SmallRadius">9</CornerRadius>
    <sys:Double x:Key="CardHeight">118</sys:Double>

    <!-- ===================== 文字 ===================== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 小标签（标题上方的灰色说明文字） -->
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- 卡片标题 -->
    <Style x:Key="CardTitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- KPI 大数字：Segoe UI 的数字更清晰（Consolas 的 0 带斜杠，加粗后像 Ø），靠右对齐保证刷新时不跳 -->
    <Style x:Key="KpiValueText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- KPI 单位（跟在数字后面的小字） -->
    <Style x:Key="KpiUnitText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- ===================== 按钮 ===================== -->
    <!-- 主按钮（导出 Excel）：主色渐变底 -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SmallRadius}"
                            SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮（幽灵按钮：描边 + 无底色） -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource SmallRadius}"
                            SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 班次页签（两行文字：班次名 + 日期） ===================== -->
    <Style x:Key="ShiftTab" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                            SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 主题开关（月亮 / 太阳） ===================== -->
    <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="64" Height="32">
                        <!-- 轨道：3D 质感（inset 阴影），借鉴 galaxy Admin12121 massive-dodo-67 -->
                        <Border x:Name="Track" CornerRadius="16" Background="#252532" BorderBrush="#32303E" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <!-- 滑块 -->
                        <Border x:Name="Knob" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                VerticalAlignment="Center" Background="#4A495E">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.6" />
                            </Border.Effect>
                            <!-- Border 只能有一个子级，所以月亮与太阳叠在同一个 Grid 里 -->
                            <Grid>
                                <TextBlock x:Name="Moon" Text="☾" FontSize="12" Foreground="#CFD8E8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="Sun" Text="☀" FontSize="12" Foreground="#06121F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Knob" Property="Background" Value="#3B82F6" />
                            <Setter TargetName="Track" Property="Background" Value="#1D3557" />
                            <Setter TargetName="Moon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sun" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 语言按钮组 ===================== -->
    <Style x:Key="LangButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 窗口按钮（自绘标题栏：最小化 / 最大化 / 关闭） ===================== -->
    <Style x:Key="窗口按钮" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Panel3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮：悬停变红（Windows 习惯） -->
    <Style x:Key="关闭按钮" TargetType="Button" BasedOn="{StaticResource 窗口按钮}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E0455A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 卡片 ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!-- KPI 卡片：左侧一条主色竖条（用 Grid + Border 实现，见 MainWindow） -->
    <Style x:Key="KpiIconBox" TargetType="Border">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== 表格 ===================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="ColumnHeaderHeight" Value="40" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!-- 表格数字用 Segoe UI（Consolas 的 0 带斜杠，看着像 ø）；列是右对齐，视觉上照样对齐 -->
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeadBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource HeadTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <!-- 表头：底部横线 + 右侧竖线（竖线让"列名"和"列下的 item"一眼对上） -->
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <!--
            自定义行模板：
            WPF 默认行模板在"模板触发器"里直接把行底色写死成系统高亮色（深蓝）+ 白色文字，
            会盖掉主题配色（深蓝和本主题不搭，合计行选中时尤其突兀）。
            这里自己写模板：选中/悬停都用主题主色浅底，文字始终用主题文字色。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border x:Name="行底色" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <DataGridCellsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="行底色" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            </Trigger>
            <!-- 合计行（最后一行的"白班/夜班"）：主色底 + 加粗 -->
            <DataTrigger Binding="{Binding IsTotal}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <!-- 单元格右边框 = 列与列之间的竖向分割线（与表头竖线同色同位置，上下贯通） -->
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        表格 item 居中：
        WPF 里 DataGridCell.HorizontalContentAlignment 对 DataGridTextColumn **不生效**，
        列里生成的是 TextBlock，它自己按 Stretch 排列 → 文字仍然左对齐。
        唯一可靠的办法是给列加 ElementStyle（TargetType=TextBlock）强制居中。
    -->
    <Style x:Key="TableCellText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ===================== 滚动条（深色下默认滚动条太亮，做一个细的） ===================== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Line2Brush}" CornerRadius="4" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
